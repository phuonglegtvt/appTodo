# Cấu hình Supabase — sao chép file này thành .env rồi điền giá trị thật.
# Lấy tại: Supabase Dashboard > Project Settings > API
# LƯU Ý: chỉ dùng anon key ở frontend (an toàn nhờ Row Level Security).
#        TUYỆT ĐỐI không đưa service_role key vào đây.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
